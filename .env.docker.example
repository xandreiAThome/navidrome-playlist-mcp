# Copy to .env and replace these values. Never commit .env.
# For Navidrome on the Docker host, use host.docker.internal, not localhost.
# Navidrome must listen on an interface reachable from the container.
NAVIDROME_URL=http://host.docker.internal:4533
NAVIDROME_USERNAME=your-user
# Single quotes preserve literal dollar signs and hash characters in passwords.
NAVIDROME_PASSWORD='replace-me'
NAVIDROME_REQUIRE_APPROVAL=false
NAVIDROME_TIMEOUT_MS=15000
NAVIDROME_SEARCH_PAGE_SIZE=100
NAVIDROME_SEARCH_MAX_PAGES=20
# Compose fixes NAVIDROME_DB_PATH to /data/playlists.sqlite in a named volume.
