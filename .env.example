# Example only: replace with your Navidrome base URL and Subsonic credentials.
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USERNAME=your-user
NAVIDROME_PASSWORD=replace-me
# Use an absolute path when launching through an MCP client.
NAVIDROME_DB_PATH=.data/playlists.sqlite
NAVIDROME_REQUIRE_APPROVAL=false
NAVIDROME_TIMEOUT_MS=15000
NAVIDROME_SEARCH_PAGE_SIZE=100
NAVIDROME_SEARCH_MAX_PAGES=20
