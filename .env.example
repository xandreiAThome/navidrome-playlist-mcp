# Example only: replace with your Navidrome base URL and Subsonic credentials.
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USERNAME=your-user
NAVIDROME_PASSWORD=replace-me
# Use an absolute path when launching through an MCP client.
NAVIDROME_DB_PATH=.data/playlists.sqlite
NAVIDROME_REQUIRE_APPROVAL=false
NAVIDROME_TIMEOUT_MS=15000
NAVIDROME_SEARCH_PAGE_SIZE=100
NAVIDROME_SEARCH_MAX_PAGES=20

# Optional separately managed AudioMuse-AI v3.7.1 instance.
# Set all three together. Leave them unset for explicit song lists only.
# AUDIOMUSE_URL=http://localhost:8000
# AUDIOMUSE_API_TOKEN=replace-me
# AUDIOMUSE_SERVER=your-navidrome-server-id
# Overall discovery/expansion budget, including Navidrome validation.
# AUDIOMUSE_BUDGET_MS=60000
# No default quality floor: provide a deployment-bound calibration file.
# AUDIOMUSE_CALIBRATION_PATH=/absolute/path/to/calibration.json
