{
  "name": "@xandreiathome/navidrome-playlist-mcp",
  "version": "0.1.1",
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "description": "Local agent-driven Navidrome playlist service",
  "bin": {
    "navidrome-playlist-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "engines": {
    "node": ">=26.13.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xandreiAThome/navidrome-playlist-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/cli.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "test": "pnpm build && vitest run",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project integration",
    "test:coverage": "pnpm build && vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:pack": "node scripts/pack-smoke.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@clack/core": "1.6.0",
    "@clack/prompts": "^1.9.0",
    "@iarna/toml": "2.2.5",
    "@modelcontextprotocol/server": "2.4.0",
    "add-mcp": "2.6.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "jsonc-parser": "3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
